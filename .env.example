# SE-Viz environment — copy what you need into `.env.local` (gitignored).
# Both vars are OPTIONAL. With neither set the app is the pure curriculum workbench
# (exactly what production runs today) and the Live Coding entry is hidden.

# Base URL of the SE-Viz Tracer backend (the compile-and-run service, separate repo).
# Setting it is what ENABLES Live Coding mode. For LOCAL dev use the dev-server proxy
# path below (the backend has no CORS yet, so the browser can't call :8080 directly;
# Vite forwards /tracer-api → http://localhost:8080). See docs/LOCAL_LIVE_CODING.md.
#VITE_TRACER_URL=/tracer-api

# Optional bearer token sent to the tracer as `Authorization: Bearer <token>`.
# Forward-compat only: the backend has no auth yet (its Phase 04 adds it), so leave
# this unset for local development.
#VITE_TRACER_TOKEN=
