exports[`NdarrayView > a view says whose memory it uses; its dashed link joins the two boxes 1`] = `"<svg class="pointer-events-none absolute inset-0 z-10 h-full w-full overflow-visible" aria-hidden="true"><defs><marker id="se-view-of" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="var(--se-heap)"></path></marker></defs><g><path d="M 500 173 L 574 173 L 574 53 L 562 53" fill="none" stroke="var(--se-heap)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#se-view-of)"></path><text x="578" y="113" fill="var(--se-heap)" font-size="10" font-family="var(--font-mono, monospace)" dominant-baseline="middle">view of</text></g><g><path d="M 500 413 L 584 413 L 584 53 L 562 53" fill="none" stroke="var(--se-heap)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#se-view-of)"></path><text x="588" y="233" fill="var(--se-heap)" font-size="10" font-family="var(--font-mono, monospace)" dominant-baseline="middle">view of</text></g></svg>"`;
