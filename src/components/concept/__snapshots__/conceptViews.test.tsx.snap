urve-1)" stroke-width="3" stroke-dasharray="7 4"></line></svg>O(log n)</th><th scope="col" data-row="n" class="border border-hairline px-2 py-1 text-left font-normal text-ink "><svg width="22" height="10" aria-hidden="true" class="mr-1.5 inline-block"><line x1="1" x2="21" y1="5" y2="5" stroke="var(--se-cv-curve-2)" stroke-width="3"></line></svg>O(n)</th><th scope="col" data-row="nlog" class="border border-hairline px-2 py-1 text-left font-normal text-ink bg-active-soft"><svg width="22" height="10" aria-hidden="true" class="mr-1.5 inline-block"><line x1="1" x2="21" y1="5" y2="5" stroke="var(--se-cv-curve-3)" stroke-width="3" stroke-dasharray="12 4 3 4"></line></svg>O(n log n)</th><th scope="col" data-row="n2" class="border border-hairline px-2 py-1 text-left font-normal text-ink bg-active-soft"><svg width="22" height="10" aria-hidden="true" class="mr-1.5 inline-block"><line x1="1" x2="21" y1="5" y2="5" stroke="var(--se-cv-curve-4)" stroke-width="3"></line></svg>O(n²)</th></tr><tr><td class="border border-hairline px-2 py-1 text-right font-semibold text-ink ">1</td><td class="border border-hairline px-2 py-1 text-right font-semibold text-ink ">6</td><td class="border border-hairline px-2 py-1 text-right font-semibold text-ink ">64</td><td class="border border-hairline px-2 py-1 text-right font-semibold text-ink bg-active-soft">384</td><td class="border border-hairline px-2 py-1 text-right font-semibold text-ink bg-active-soft">4,096</td></tr></tbody></table><p class="font-sans text-sm text-ink" data-caption="true">At n = 64, O(n²) does 4,096 operations and O(n log n) does 384: 10.7 times as many.</p></div>"`;

